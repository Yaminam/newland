# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Supabase (required) -------------------------------------------------
# Project URL — Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co
# Anon/public key — Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=

# --- App URL (required) --------------------------------------------------
# Base origin used for auth redirect URLs. Use http://localhost:5173 in dev.
VITE_APP_URL=http://localhost:5173

# --- Google Analytics (optional) ----------------------------------------
# GA4 Measurement ID (G-XXXXXXXXXX). Leave blank to disable.
VITE_GA4_ID=

# --- Security event collector (optional) --------------------------------
# POST endpoint for auth/error events (e.g. a Supabase Edge Function URL).
# Leave blank to silently no-op security logging.
# VITE_SECURITY_EVENT_ENDPOINT=
